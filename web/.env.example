# Base URL of the Django REST backend (Railway in prod, `npm run mock` or runserver in dev)
VITE_API_URL=http://localhost:8000
# Web OAuth client ID from Google Cloud Console (separate from the Android client)
VITE_GOOGLE_CLIENT_ID=
# Optional, dev only: a JWT to call the API directly, bypassing sign-in
VITE_DEV_TOKEN=
