<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules file - see https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The auth DataStore holds the raw JWT access token in plaintext - it must never be
         swept into a device backup/restore, where it could end up on a different device or be
         extracted from backup storage. -->
    <exclude domain="file" path="datastore/auth.preferences_pb"/>
</full-backup-content>
