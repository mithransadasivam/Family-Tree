<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules - see https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The auth DataStore holds the raw JWT access token in plaintext - never include it
             in cloud backups. -->
        <exclude domain="file" path="datastore/auth.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
